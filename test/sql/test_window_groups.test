# name: test/sql/test_window_groups.test
# description: Preserve peer groups when exporting GROUPS window frames
# group: [sql]

require substrait

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE window_groups AS SELECT * FROM (VALUES (1,10),(2,20),(3,20),(4,40)) v(id,val)

query IIIII
SELECT id,
       sum(val) OVER (ORDER BY val GROUPS BETWEEN CURRENT ROW AND CURRENT ROW),
       sum(val) OVER (ORDER BY val GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
       sum(val) OVER (ORDER BY val GROUPS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING),
       sum(val) OVER (ORDER BY val GROUPS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
FROM window_groups ORDER BY id
----
1	10	10	90	90
2	40	50	80	90
3	40	50	80	90
4	40	90	40	90

statement ok
SET VARIABLE groups_ascending = (SELECT json FROM get_substrait_json('SELECT id, sum(val) OVER (ORDER BY val GROUPS BETWEEN CURRENT ROW AND CURRENT ROW), sum(val) OVER (ORDER BY val GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), sum(val) OVER (ORDER BY val GROUPS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING), sum(val) OVER (ORDER BY val GROUPS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM window_groups'))

query IIIII
SELECT * FROM from_substrait_json(getvariable('groups_ascending')) ORDER BY 1
----
1	10	10	90	90
2	40	50	80	90
3	40	50	80	90
4	40	90	40	90

query II
SELECT contains(getvariable('groups_ascending'), 'BOUNDS_TYPE_RANGE')::INTEGER, contains(getvariable('groups_ascending'), 'BOUNDS_TYPE_ROWS')::INTEGER
----
1	0

query IIIII
SELECT id,
       sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN CURRENT ROW AND CURRENT ROW),
       sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
       sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING),
       sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
FROM window_groups ORDER BY id
----
1	10	90	10	90
2	40	80	50	90
3	40	80	50	90
4	40	40	90	90

statement ok
SET VARIABLE groups_descending = (SELECT * FROM get_substrait('SELECT id, sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN CURRENT ROW AND CURRENT ROW), sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING), sum(val) OVER (ORDER BY val DESC GROUPS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM window_groups'))

query IIIII
SELECT * FROM from_substrait(getvariable('groups_descending')) ORDER BY 1
----
1	10	90	10	90
2	40	80	50	90
3	40	80	50	90
4	40	40	90	90

statement ok
CREATE TABLE window_groups_nulls AS SELECT * FROM (VALUES (1,NULL,1),(2,NULL,1),(3,NULL,2),(4,10,1),(5,10,1)) v(id,val,k)

query II
SELECT id, sum(id) OVER (ORDER BY val NULLS FIRST, k GROUPS BETWEEN CURRENT ROW AND CURRENT ROW) FROM window_groups_nulls ORDER BY id
----
1	3
2	3
3	3
4	9
5	9

statement ok
SET VARIABLE groups_nulls = (SELECT json FROM get_substrait_json('SELECT id, sum(id) OVER (ORDER BY val NULLS FIRST, k GROUPS BETWEEN CURRENT ROW AND CURRENT ROW) FROM window_groups_nulls'))

query II
SELECT * FROM from_substrait_json(getvariable('groups_nulls')) ORDER BY 1
----
1	3
2	3
3	3
4	9
5	9

statement error
SELECT json FROM get_substrait_json('SELECT sum(val) OVER (ORDER BY val GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM window_groups')
----
GROUPS window frames with offsets are not supported

statement error
SELECT json FROM get_substrait_json('SELECT sum(val) OVER (ORDER BY val GROUPS BETWEEN CURRENT ROW AND 1 FOLLOWING) FROM window_groups')
----
GROUPS window frames with offsets are not supported

statement error
SELECT * FROM get_substrait('SELECT sum(val) OVER (ORDER BY val GROUPS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) FROM window_groups')
----
GROUPS window frames with offsets are not supported

statement error
SELECT * FROM get_substrait('SELECT sum(val) OVER (ORDER BY val GROUPS BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING) FROM window_groups')
----
GROUPS window frames with offsets are not supported
