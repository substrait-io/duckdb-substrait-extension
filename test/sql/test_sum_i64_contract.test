# name: test/sql/test_sum_i64_contract.test
# description: Consume integer SUM signatures with their declared BIGINT result
# group: [sql]

require substrait

statement ok
PRAGMA enable_verification

# The fixtures were exported by Isthmus from this DDL and these SQL queries:
# SELECT SUM(c0) AS s FROM t_sum
# SELECT c1, SUM(c0) AS s FROM t_sum GROUP BY c1
# functions_arithmetic declares sum(i64) -> i64?, including NULL on empty input.
statement ok
CREATE TABLE t_sum (c0 BIGINT NOT NULL, c1 BIGINT NOT NULL);

statement ok
SET VARIABLE plain = (SELECT content FROM read_text('test/data/isthmus_sum_plain_i64.json'));

statement ok
SET VARIABLE grouped = (SELECT content FROM read_text('test/data/isthmus_sum_group_i64.json'));

statement ok
INSERT INTO t_sum VALUES (1,0), (2,0), (3,1);

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain'))
----
BIGINT	6

query ITI rowsort
SELECT c1, typeof(s), s FROM from_substrait_json(getvariable('grouped'))
----
0	BIGINT	3
1	BIGINT	3

# DuckDB's own SQL retains its wider accumulator and result type.
query TI
SELECT typeof(sum(c0)), sum(c0) FROM t_sum
----
HUGEINT	6

statement ok
DELETE FROM t_sum;

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain'))
----
BIGINT	NULL

query I
SELECT count(*) FROM from_substrait_json(getvariable('grouped'))
----
0

statement ok
INSERT INTO t_sum VALUES (1,0), (1,0), (2,1);

statement ok
SET VARIABLE distinct_plan = replace(getvariable('plain'), 'AGGREGATION_INVOCATION_ALL', 'AGGREGATION_INVOCATION_DISTINCT');

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('distinct_plan'))
----
BIGINT	3

statement ok
SET VARIABLE error_plan = replace(getvariable('plain'), '"functionReference": 1', '"functionReference": 1, "options": [{"name":"overflow", "preference":["ERROR"]}]');

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('error_plan'))
----
BIGINT	4

# Widening the accumulator is useful even though the result stays i64.
statement ok
DELETE FROM t_sum;

statement ok
INSERT INTO t_sum VALUES (9223372036854775807,0), (1,0), (-1,0);

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain'))
----
BIGINT	9223372036854775807

# With no overflow preference the consumer may select ERROR. It must not return
# a HUGEINT value outside the declared result type.
statement ok
DELETE FROM t_sum;

statement ok
INSERT INTO t_sum VALUES (4611686018427387904,0), (4611686018427387904,0), (4611686018427387904,0);

statement error
SELECT * FROM from_substrait_json(getvariable('plain'))
----
out of range

statement error
SELECT * FROM from_substrait_json(getvariable('grouped'))
----
out of range

statement error
SELECT * FROM from_substrait_json(getvariable('error_plan'))
----
out of range

# Preferences may include a fallback which this consumer can deliver.
statement ok
SET VARIABLE fallback_plan = replace(getvariable('error_plan'), '["ERROR"]', '["SATURATE","ERROR"]');

statement error
SELECT * FROM from_substrait_json(getvariable('fallback_plan'))
----
out of range

# Only ERROR is supported by the checked cast, so do not silently ignore
# an explicit request for a different overflow behavior.
statement ok
SET VARIABLE silent_plan = replace(getvariable('error_plan'), '["ERROR"]', '["SILENT"]');

statement error
SELECT * FROM from_substrait_json(getvariable('silent_plan'))
----
sum:i64 supports only ERROR overflow behavior

statement ok
SET VARIABLE saturate_plan = replace(getvariable('error_plan'), '["ERROR"]', '["SATURATE"]');

statement error
SELECT * FROM from_substrait_json(getvariable('saturate_plan'))
----
sum:i64 supports only ERROR overflow behavior

# Check the lower boundary too.
statement ok
DELETE FROM t_sum;

statement ok
INSERT INTO t_sum VALUES (-9223372036854775808,0), (-1,0);

statement error
SELECT * FROM from_substrait_json(getvariable('plain'))
----
out of range

# Retype only the required input fields in the Isthmus fixtures. The nullable
# output stays i64 for each standard integer SUM signature.
statement ok
CREATE MACRO integer_sum_plan(plan, signature, table_name) AS
    regexp_replace(replace(replace(plan, 'sum:i64', 'sum:' || signature), 'T_SUM', table_name),
                   '"i64"(\s*:\s*\{\s*"nullability"\s*:\s*"NULLABILITY_REQUIRED")',
                   '"' || signature || '"\1', 'g');

statement ok
CREATE TABLE t_sum_i8 (c0 TINYINT NOT NULL, c1 TINYINT NOT NULL);

statement ok
INSERT INTO t_sum_i8 VALUES (1,0), (1,0), (2,1);

statement ok
SET VARIABLE plain_i8 = integer_sum_plan(getvariable('plain'), 'i8', 'T_SUM_I8');

statement ok
SET VARIABLE grouped_i8 = integer_sum_plan(getvariable('grouped'), 'i8', 'T_SUM_I8');

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i8'))
----
BIGINT	4

query ITI rowsort
SELECT c1, typeof(s), s FROM from_substrait_json(getvariable('grouped_i8'))
----
0	BIGINT	2
1	BIGINT	2

query TI
SELECT typeof(s), s FROM from_substrait_json(integer_sum_plan(getvariable('distinct_plan'), 'i8', 'T_SUM_I8'))
----
BIGINT	3

statement ok
DELETE FROM t_sum_i8;

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i8'))
----
BIGINT	NULL

query I
SELECT count(*) FROM from_substrait_json(getvariable('grouped_i8'))
----
0

statement ok
CREATE TABLE t_sum_i16 (c0 SMALLINT NOT NULL, c1 SMALLINT NOT NULL);

statement ok
INSERT INTO t_sum_i16 VALUES (1,0), (1,0), (2,1);

statement ok
SET VARIABLE plain_i16 = integer_sum_plan(getvariable('plain'), 'i16', 'T_SUM_I16');

statement ok
SET VARIABLE grouped_i16 = integer_sum_plan(getvariable('grouped'), 'i16', 'T_SUM_I16');

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i16'))
----
BIGINT	4

query ITI rowsort
SELECT c1, typeof(s), s FROM from_substrait_json(getvariable('grouped_i16'))
----
0	BIGINT	2
1	BIGINT	2

query TI
SELECT typeof(s), s FROM from_substrait_json(integer_sum_plan(getvariable('distinct_plan'), 'i16', 'T_SUM_I16'))
----
BIGINT	3

statement ok
DELETE FROM t_sum_i16;

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i16'))
----
BIGINT	NULL

query I
SELECT count(*) FROM from_substrait_json(getvariable('grouped_i16'))
----
0

statement ok
CREATE TABLE t_sum_i32 (c0 INTEGER NOT NULL, c1 INTEGER NOT NULL);

statement ok
INSERT INTO t_sum_i32 VALUES (1,0), (1,0), (2,1);

statement ok
SET VARIABLE plain_i32 = integer_sum_plan(getvariable('plain'), 'i32', 'T_SUM_I32');

statement ok
SET VARIABLE grouped_i32 = integer_sum_plan(getvariable('grouped'), 'i32', 'T_SUM_I32');

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i32'))
----
BIGINT	4

query ITI rowsort
SELECT c1, typeof(s), s FROM from_substrait_json(getvariable('grouped_i32'))
----
0	BIGINT	2
1	BIGINT	2

query TI
SELECT typeof(s), s FROM from_substrait_json(integer_sum_plan(getvariable('distinct_plan'), 'i32', 'T_SUM_I32'))
----
BIGINT	3

statement ok
DELETE FROM t_sum_i32;

query TI
SELECT typeof(s), s FROM from_substrait_json(getvariable('plain_i32'))
----
BIGINT	NULL

query I
SELECT count(*) FROM from_substrait_json(getvariable('grouped_i32'))
----
0

# Unsupported overflow behavior is rejected for the smaller signatures too.
statement error
SELECT * FROM from_substrait_json(integer_sum_plan(getvariable('silent_plan'), 'i32', 'T_SUM_I32'))
----
sum:i32 supports only ERROR overflow behavior
