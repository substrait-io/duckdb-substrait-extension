0.816496580927726
0.816496580927726

# --- variants with no DuckDB equivalent must be rejected, not defaulted ---

# median APPROXIMATE maps to DuckDB's exact median: the spec only asks that an approximate
# result lie between the input's minimum and maximum
query I
SELECT * FROM from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"https://github.com/substrait-io/substrait/blob/main/extensions/functions_arithmetic.yaml"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"median:req_fp64"}}],"relations":[{"root":{"input":{"aggregate":{"common":{"direct":{}},"input":{"read":{"common":{"direct":{}},"baseSchema":{"names":["x"],"struct":{"types":[{"fp64":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":["t"]}}},"measures":[{"measure":{"functionReference":1,"phase":"AGGREGATION_PHASE_INITIAL_TO_RESULT","outputType":{"fp64":{"nullability":"NULLABILITY_NULLABLE"}},"invocation":"AGGREGATION_INVOCATION_ALL","arguments":[{"enum":"APPROXIMATE"},{"value":{"selection":{"directReference":{"structField":{"field":0}},"rootReference":{}}}}]}}]}},"names":["r"]}}]}')
----
2.0

# the spec's quantile shape is [boundaries enum, precision enum, i64, any], so a real plan
# hits the multi-enum branch
statement error
CALL from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"https://github.com/substrait-io/substrait/blob/main/extensions/functions_arithmetic.yaml"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"quantile:req_req_i64_any"}}],"relations":[{"root":{"input":{"aggregate":{"common":{"direct":{}},"input":{"read":{"common":{"direct":{}},"baseSchema":{"names":["x"],"struct":{"types":[{"fp64":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":["t"]}}},"measures":[{"measure":{"functionReference":1,"phase":"AGGREGATION_PHASE_INITIAL_TO_RESULT","outputType":{"fp64":{"nullability":"NULLABILITY_NULLABLE"}},"invocation":"AGGREGATION_INVOCATION_ALL","arguments":[{"enum":"BOTH"},{"enum":"EXACT"},{"value":{"selection":{"directReference":{"structField":{"field":0}},"rootReference":{}}}},{"value":{"selection":{"directReference":{"structField":{"field":0}},"rootReference":{}}}}]}}]}},"names":["r"]}}]}')
----
Function "quantile" with 2 enumeration arguments is not supported yet

# an unrecognised option is rejected, not defaulted
statement error
CALL from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"https://github.com/substrait-io/substrait/blob/main/extensions/functions_arithmetic.yaml"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"std_dev:req_fp64"}}],"relations":[{"root":{"input":{"aggregate":{"common":{"direct":{}},"input":{"read":{"common":{"direct":{}},"baseSchema":{"names":["x"],"struct":{"types":[{"fp64":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":["t"]}}},"measures":[{"measure":{"functionReference":1,"phase":"AGGREGATION_PHASE_INITIAL_TO_RESULT","outputType":{"fp64":{"nullability":"NULLABILITY_NULLABLE"}},"invocation":"AGGREGATION_INVOCATION_ALL","arguments":[{"enum":"BOGUS"},{"value":{"selection":{"directReference":{"structField":{"field":0}},"rootReference":{}}}}]}}]}},"names":["r"]}}]}')
----
Function "std_dev" with enumeration argument "BOGUS"

# an argument with no value, type or enum set is malformed, not an empty enum
statement error
CALL from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"https://github.com/substrait-io/substrait/blob/main/extensions/functions_arithmetic.yaml"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"sum:fp64"}}],"relations":[{"root":{"input":{"aggregate":{"common":{"direct":{}},"input":{"read":{"common":{"direct":{}},"baseSchema":{"names":["x"],"struct":{"types":[{"fp64":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":["t"]}}},"measures":[{"measure":{"functionReference":1,"phase":"AGGREGATION_PHASE_INITIAL_TO_RESULT","outputType":{"fp64":{"nullability":"NULLABILITY_NULLABLE"}},"invocation":"AGGREGATION_INVOCATION_ALL","arguments":[{}]}}]}},"names":["r"]}}]}')
----
Substrait aggregate argument has no value, type or enum set

# Substrait's integer median returns an integer with a rounding option; DuckDB's median
# averages the two middle values and returns DOUBLE, so the integer impls are rejected
statement error
CALL from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"https://github.com/substrait-io/substrait/blob/main/extensions/functions_arithmetic.yaml"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"median:req_i64"}}],"relations":[{"root":{"input":{"aggregate":{"common":{"direct":{}},"input":{"read":{"common":{"direct":{}},"baseSchema":{"names":["x"],"struct":{"types":[{"i64":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":["t"]}}},"measures":[{"measure":{"functionReference":1,"phase":"AGGREGATION_PHASE_INITIAL_TO_RESULT","outputType":{"i64":{"nullability":"NULLABILITY_NULLABLE"}},"invocation":"AGGREGATION_INVOCATION_ALL","arguments":[{"enum":"EXACT"},{"value":{"selection":{"directReference":{"structField":{"field":0}},"rootReference":{}}}}]}}]}},"names":["r"]}}]}')
----
Substrait median over i64 is not supported yet
