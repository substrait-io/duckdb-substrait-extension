# name: test/sql/test_substrait_subquery.test
# description: Consume Substrait Expression.Subquery (scalar, IN, EXISTS, ANY)
# group: [sql]

require substrait

require json

statement ok
CREATE TABLE t1 (a INTEGER);

statement ok
CREATE TABLE t2 (b INTEGER);

statement ok
INSERT INTO t1 VALUES (1), (2), (3), (5), (9);

statement ok
INSERT INTO t2 VALUES (2), (3);

# The producer never emits Expression.Subquery -- DuckDB decorrelates subqueries into
# joins before it runs -- so these plans are handwritten. Each is checked against the
# SQL it is equivalent to, shown above it.

# Scalar subquery: a > (SELECT max(b) FROM t2)
query I
SELECT a FROM from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"extension:io.substrait:functions_comparison"},{"extensionUrnAnchor":2,"urn":"extension:io.substrait:functions_arithmetic"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"gt:any_any"}},{"extensionFunction":{"extensionUrnReference":2,"functionAnchor":2,"name":"max:i32"}}],"relations":[{"root":{"input":{"filter":{"input":{"read":{"baseSchema":{"names":["a"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t1"]}}},"condition":{"scalarFunction":{"functionReference":1,"outputType":{"bool":{"nullability":"NULLABILITY_NULLABLE"}},"arguments":[{"value":{"selection":{"directReference":{"structField":{}},"rootReference":{}}}},{"value":{"subquery":{"scalar":{"input":{"aggregate":{"input":{"read":{"baseSchema":{"names":["b"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t2"]}}},"groupings":[{}],"measures":[{"measure":{"functionReference":2,"outputType":{"i32":{"nullability":"NULLABILITY_NULLABLE"}},"arguments":[{"value":{"selection":{"directReference":{"structField":{}},"rootReference":{}}}}]}}]}}}}}}]}}}},"names":["a"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}') ORDER BY a
----
5
9

# IN predicate: a IN (SELECT b FROM t2)
query I
SELECT a FROM from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"extension:io.substrait:functions_comparison"},{"extensionUrnAnchor":2,"urn":"extension:io.substrait:functions_arithmetic"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"gt:any_any"}},{"extensionFunction":{"extensionUrnReference":2,"functionAnchor":2,"name":"max:i32"}}],"relations":[{"root":{"input":{"filter":{"input":{"read":{"baseSchema":{"names":["a"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t1"]}}},"condition":{"subquery":{"inPredicate":{"needles":[{"selection":{"directReference":{"structField":{}},"rootReference":{}}}],"haystack":{"read":{"baseSchema":{"names":["b"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t2"]}}}}}}}},"names":["a"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}') ORDER BY a
----
2
3

# EXISTS predicate: EXISTS (SELECT b FROM t2)
query I
SELECT a FROM from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"extension:io.substrait:functions_comparison"},{"extensionUrnAnchor":2,"urn":"extension:io.substrait:functions_arithmetic"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"gt:any_any"}},{"extensionFunction":{"extensionUrnReference":2,"functionAnchor":2,"name":"max:i32"}}],"relations":[{"root":{"input":{"filter":{"input":{"read":{"baseSchema":{"names":["a"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t1"]}}},"condition":{"subquery":{"setPredicate":{"predicateOp":"PREDICATE_OP_EXISTS","tuples":{"read":{"baseSchema":{"names":["b"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t2"]}}}}}}}},"names":["a"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}') ORDER BY a
----
1
2
3
5
9

# ANY comparison: a > ANY (SELECT b FROM t2)
query I
SELECT a FROM from_substrait_json('{"extensionUrns":[{"extensionUrnAnchor":1,"urn":"extension:io.substrait:functions_comparison"},{"extensionUrnAnchor":2,"urn":"extension:io.substrait:functions_arithmetic"}],"extensions":[{"extensionFunction":{"extensionUrnReference":1,"functionAnchor":1,"name":"gt:any_any"}},{"extensionFunction":{"extensionUrnReference":2,"functionAnchor":2,"name":"max:i32"}}],"relations":[{"root":{"input":{"filter":{"input":{"read":{"baseSchema":{"names":["a"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t1"]}}},"condition":{"subquery":{"setComparison":{"reductionOp":"REDUCTION_OP_ANY","comparisonOp":"COMPARISON_OP_GT","left":{"selection":{"directReference":{"structField":{}},"rootReference":{}}},"right":{"read":{"baseSchema":{"names":["b"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{}]},"maintainSingularStruct":true},"namedTable":{"names":["t2"]}}}}}}}},"names":["a"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}') ORDER BY a
----
