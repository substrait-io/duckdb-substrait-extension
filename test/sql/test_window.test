statement ok
SET VARIABLE zero_offset_plan = (SELECT json FROM get_substrait_json('SELECT id, sum(val) OVER (PARTITION BY part1 ORDER BY id ROWS BETWEEN 0 PRECEDING AND CURRENT ROW) AS total FROM window_test_data'))

query TT
