# name: test/sql/test_named_table_resolution.test
# description: Test from_substrait_json resolves multi-component namedTable.names
# group: [sql]

require substrait
require json

statement ok
CREATE SCHEMA myschema

statement ok
CREATE TABLE myschema.suppliers (supplier_id BIGINT, supplier_name VARCHAR)

statement ok
INSERT INTO myschema.suppliers VALUES (1, 'Acme Corp'), (2, 'Widgets Ltd'), (3, 'Gizmo Inc')

# 2-component: ["myschema", "suppliers"]
query IT
CALL from_substrait_json('{"relations":[{"root":{"input":{"fetch":{"input":{"read":{"baseSchema":{"names":["supplier_id","supplier_name"],"struct":{"types":[{"i64":{"nullability":"NULLABILITY_NULLABLE"}},{"string":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"projection":{"select":{"structItems":[{},{"field":1}]},"maintainSingularStruct":true},"namedTable":{"names":["myschema","suppliers"]}}},"offsetExpr":{"literal":{"i64":"0"}},"countExpr":{"literal":{"i64":"5"}}}},"names":["supplier_id","supplier_name"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}')
----
1	Acme Corp
2	Widgets Ltd
3	Gizmo Inc

statement ok
ATTACH ':memory:' AS db

statement ok
CREATE SCHEMA db.s

statement ok
CREATE TABLE db.main.t (x INTEGER)

statement ok
INSERT INTO db.main.t VALUES (99)

statement ok
CREATE TABLE db.s.t (x INTEGER)

statement ok
INSERT INTO db.s.t VALUES (42)

statement ok
CREATE VIEW db.main.v AS SELECT 99 AS x

statement ok
CREATE VIEW db.s.v AS SELECT 42 AS x

statement ok
CREATE MACRO named_table_plan(table_names) AS
    '{"relations":[{"root":{"input":{"read":{"baseSchema":{"names":["x"],"struct":{"types":[{"i32":{"nullability":"NULLABILITY_NULLABLE"}}],"nullability":"NULLABILITY_REQUIRED"}},"namedTable":{"names":'
    || to_json(table_names) ||
    '}}},"names":["x"]}}],"version":{"minorNumber":78,"producer":"DuckDB"}}'

# A three-part name keeps the attached catalog and requested schema separate.
query I
SELECT * FROM from_substrait_json(named_table_plan(['db', 's', 't']))
----
42

# The same qualification is used when the target is a view.
query I
SELECT * FROM from_substrait_json(named_table_plan(['db', 's', 'v']))
----
42

# Two-part attached-catalog shorthand still resolves against its default schema.
query I
SELECT * FROM from_substrait_json(named_table_plan(['db', 't']))
----
99
